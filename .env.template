# =============================================================
# Microsoft Foundry Demo Configuration
# Copy this file to .env and fill in your values:
#   cp .env.template .env
# =============================================================

# Required for all demos
AZURE_AI_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o

# Demo 1c: Model Router (deploy "model-router" from model catalog first)
MODEL_ROUTER_DEPLOYMENT_NAME=model-router

# Demo 3: Hosted Agents (only needed for Demo 3)
ACR_NAME=<your-acr-name>
FOUNDRY_ACCOUNT_NAME=<your-foundry-account-name>
FOUNDRY_PROJECT_NAME=<your-project-name>
FOUNDRY_RESOURCE_GROUP=<your-resource-group>

# Demo 4b: Azure Monitor tracing (only needed for Demo 4b)
# Leave empty to skip Azure Monitor; console tracing (4a) works without this
APPLICATIONINSIGHTS_CONNECTION_STRING=
